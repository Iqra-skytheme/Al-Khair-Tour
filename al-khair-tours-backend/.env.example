# Copy this file to .env and fill in real values.

PORT=5000

# Allow the Next.js frontend to call this API (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# --- Supabase (used ONLY for admin login/authentication — no data is stored here) ---
# Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable / anon key (safe key, NOT the secret/service_role one — we only verify passwords with it)
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- MongoDB (all real data: vehicles, ziyarat packages, bookings, admin roles) ---
# MongoDB Atlas -> Connect -> Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/al-khair-tours

# Any long random string. Used to sign the admin session JWT issued by this server.
ADMIN_JWT_SECRET=change_this_to_a_long_random_string
ADMIN_JWT_EXPIRES_IN=7d
