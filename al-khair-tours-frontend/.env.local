# Copy this file to .env.local and fill in your real values.
# Next.js talks to the Express API (server/), not to Supabase directly.

# Used by Server Components, Server Actions, and middleware (runs on the server, so no NEXT_PUBLIC_ prefix needed).
API_URL=http://localhost:5000

# Only needed if some client-side code ever needs to call the API directly from the browser.
NEXT_PUBLIC_API_URL=http://localhost:5000
# CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@izephtcl
